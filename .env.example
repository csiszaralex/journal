# Copy this file to .env and fill in all values

# SQLite database path
DATABASE_URL=file:./data/journal.db

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Auth.js URL (required in production)
AUTH_URL=https://naplo.csalex.dev

# The single user allowed to sign in
ALLOWED_EMAIL=

# VAPID keys for Web Push — generate with: pnpm vapid:generate
# IMPORTANT: back these up; losing them invalidates all push subscriptions
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com

# Cloudflare R2 credentials for Litestream backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Skip env validation during CI or Docker build
# SKIP_ENV_VALIDATION=1
